  "bonferroni_error_correction": {
    "issue_description": "Phase 15 reported M=20 and Bonferroni alpha=0.0025, but in prose called an adjusted p-value of 0.0042 'significant under Bonferroni alpha=0.0025'. Comparing 0.0042 directly against 0.0025 is mathematically invalid because 0.0042 is on the adjusted p-value scale (padj = M * p), not the nominal p-value scale.",
    "mathematical_resolution": {
      "scale_1_nominal_comparison": "For hypothesis H_2025_hybrid_geo_w020_prior_a1_baseline_alpha_5, the exact nominal p-value is p = 0.000210. Comparing this nominal p directly to the Bonferroni threshold alpha/M = 0.05 / 20 = 0.0025: Since 0.000210 < 0.0025, this test IS strictly significant under the Bonferroni FWER criterion.",
      "scale_2_adjusted_comparison": "Alternatively, on the adjusted p-value scale, p_bonf = min(1.0, 20 * 0.000210) = 0.00420. This adjusted p-value must be compared to family-wise alpha = 0.05, NOT to 0.0025! Since 0.00420 < 0.05, it IS statistically significant under the Bonferroni criterion at alpha=0.05.",
      "source_of_phase_15_confusion": "Phase 15 conflated the adjusted p-value (0.0042) with the adjusted threshold (0.0025). Phase 16 eliminates this ambiguity by reporting both scales explicitly and verifying that exactly 1 of 20 tests achieves strict Bonferroni significance, 3 achieve Holm-Bonferroni significance, and 5 achieve False Discovery Rate (BH) significance."
    }
  },
  "statistical_dependency_analysis": {
    "family_definition": "20 hypothesis tests: 5 hybrid variants x 2 holdout seasons x 2 baseline references",
    "independence_assessment": "NON_INDEPENDENT (Positively Correlated)",
    "dependency_structure": "The 20 hypothesis tests are not statistically independent. Tests within each season share the exact same 24 race observations. Furthermore, the 5 hybrid models are structurally nested variants of the same underlying LightGBM predictions and empirical grid priors. As a result, the test statistics exhibit strong positive dependence.",
    "validity_under_positive_dependence": "Under Positive Regression Dependency on Subsets (PRDS), the Benjamini-Hochberg procedure remains a rigorous and mathematically valid control of the False Discovery Rate at q < 0.05. The Bonferroni and Holm procedures are valid under any dependency structure, though conservative."
  },
  "baseline_discrepancy_audit": {
    "discrepancy_identification": {
      "phase_13_2025_baseline_loss": 1.125,
      "phase_14_2025_baseline_loss": 1.1325,
      "phase_15_2025_baseline_loss": 1.1325,
      "delta": 0.0075
    },
    "exact_root_cause": "The 0.0075 log loss difference between Phase 13 (1.1250) and Phase 14/15 (1.1325) is entirely attributable to the historical training window used to fit the Laplace empirical grid baseline. In Phase 13, Approach B ('empirical_grid_baseline_2024') was fitted on the 2021-2024 dataset (90 races, 1,800 driver starts), yielding a pole-win count of 50/90 (55.56%) and Laplace pole probability of 51.52%. In Phase 14 and Phase 15, to ensure strict zero-leakage evaluation against Model B (which was trained strictly on 2021-2023), the baseline was fitted strictly on 2021-2023 (66 races, 1,320 driver starts), where the pole-win count was 36/66 (54.55%) and Laplace pole probability was 52.33%. Both calculations are mathematically correct under their respective specified training windows. Phase 14 and 15 chose the more conservative 2021-2023 baseline to guarantee that neither Model B nor the baseline had seen any 2024 results.",
    "reconciliation_verdict": "RESOLVED_TRAINING_WINDOW_ALIGNMENT"
  }
